{
  "_warning": "Application-authored data. The `signs` block holds procedural approximations for catalog entries with no plausible ASL-LEX lemma; they are not reviewed ASL and must stay labelled experimental. The `augment` block layers app-authored values on top of licensed ASL-LEX descriptors and never replaces a phonological value.",
  "_license": "CC BY-NC 4.0 - see data/LICENSE",
  "_schema": {
    "signs": "Full phonological descriptors, same shape as the ASL-LEX extract. Present only for ids that scripts/extract_asl_lex.py cannot map. `app_authored: true` marks them descriptor-free for the audit.",
    "augment": {
      "nonmanual": "browRaise / browFurrow / mouth / headShake in 0..1, optional head [pitch, yaw, roll] in radians. ASL-LEX codes no non-manual channel; these come from published ASL grammar.",
      "repeat_count": "Integer cycle count when RepeatedMovement is 1.",
      "movement_size": "Multiplier on the movement primitive amplitude.",
      "movement_axis": "vertical | lateral | forward - constrains the primitive.",
      "location_offset": "Per-sign [right, up, forward] correction in arm-reach units, measured against that entry's citation video.",
      "location_end_offset": "Additional placement correction reached across the stroke when a uniform offset cannot represent the source path.",
      "support_offset": "Additional support-hand-only [right, up, forward] correction; compensated out of the dominant path.",
      "symmetric_offset": "Additional mirrored-hand-only correction for symmetric morphemes; useful when an earlier compound phase is one-handed.",
      "hand_relation": "on_palm | on_back | on_radial | on_tip | on_heel | on_wrist | crossed | tip_to_tip | beside. Derived from ASL-LEX MinorLocation where possible; listed here only when the surface name is not enough.",
      "carried": "True when both hands move together as one contacted unit.",
      "orientation": "Palm and finger direction at the start of the sign, as unit vectors in the normalised body frame. ASL-LEX does not code palm orientation, so this is authored; without it a sign falls back to a direction derived from its region and whether it travels off the body.",
      "orientation_end": "Orientation at the end, for signs that rotate as they travel.",
      "orientation_note": "Citation-form interpretation, source URL, and scope of an orientation override; not a claim of sign-language validation."
    }
  },
