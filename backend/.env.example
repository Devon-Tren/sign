# Backend only. NEVER paste your secret into frontend files.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# Optional: gemini or openai. Defaults to Gemini when GEMINI_API_KEY is set.
SIGN_TEXT_MODEL_PROVIDER=
# Live caption latency and domain vocabulary (backend only).
SIGN_TRANSCRIPTION_DELAY=low
SIGN_SILENCE_SECONDS=0.75
SIGN_MAX_TURN_SECONDS=6
SIGN_TRANSCRIPTION_PROMPT=A classroom lecture with accessibility captions and common school vocabulary.
SIGN_TRANSCRIPTION_KEYWORDS=
# Local dev origins only; comma-separated.
SIGN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
